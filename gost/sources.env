# Исходные тексты зависимостей, которые линкуются в колесо статически.
# Файл читается сценарием gost/build-deps.sh (синтаксис sh: ИМЯ=значение).

# OpenSSL: архив выпуска и его SHA-256. Патчи — gost/patches/openssl/.
OPENSSL_VERSION=4.0.3
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-4.0.3/openssl-4.0.3.tar.gz
OPENSSL_SHA256=325b5c806167c13b40b1ffeadfe0248197c00eccc4cf123ec1e28d2d2fd216d9

# gost-engine (провайдер gostprov): полный хеш коммита, хеш его дерева для
# контроля и ожидаемая ревизия подмодуля libprov. Патчи — gost/patches/gost-engine/.
GOST_ENGINE_GIT=https://github.com/gost-engine/engine
GOST_ENGINE_COMMIT=509dcb467507149297673e68293be5b01d1aa4a8
GOST_ENGINE_TREE=77891eaada4ecee152ad13a14a561097df5f4098
GOST_ENGINE_LIBPROV=d5d381f71c90fe0c91f861784b715b189554f1f2
