From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: citrux <369565@gmail.com>
Date: Sun, 18 Oct 2026 17:22:34 +0300
Subject: [PATCH] gostprov: accept non-ASCII passwords for CryptoPro keybag
 decoding


The CryptoPro keybag KDF (PBE 1.2.840.113549.1.12.1.80) starts from the
password as a UTF-16LE (Windows wide) string. pwd_to_utf16le() only widened
ASCII and rejected any byte >= 0x80, so a PFX protected with a Cyrillic
password could not be opened at all (silently: no error on the stack).
Convert UTF-8 to UTF-16LE with OPENSSL_utf82uni instead.

Upstream-Status: pending
---
 gost_cryptopro_keybag.c | 47 +++++++++++++++++++++++------------------
 1 file changed, 27 insertions(+), 20 deletions(-)

diff --git a/gost_cryptopro_keybag.c b/gost_cryptopro_keybag.c
index 858af1856715d3982729b5d5acbf1a7e09ef6239..2f488e6a1fbc150f5b592b8a3a61c39b304c6372 100644
--- a/gost_cryptopro_keybag.c
+++ b/gost_cryptopro_keybag.c
@@ -16,6 +16,7 @@
 #include <openssl/evp.h>
 #include <openssl/objects.h>
 #include <openssl/params.h>
+#include <openssl/pkcs12.h>
 #include <openssl/x509.h>
 #include <string.h>
 #include "gost89.h"
@@ -189,33 +190,39 @@ int register_cryptopro_keybag_pbe(void)
                                 cryptopro_keybag_keygen);
 }
 
-/* ASCII-fast UTF-8 → UTF-16LE: each input byte < 0x80 becomes
- * (byte, 0x00). Returns malloc'd buffer of size 2*passlen and writes
- * the length to *out_len. Caller frees with OPENSSL_free.
- *
- * CryptoPro CSP container passwords are practically always ASCII;
- * non-ASCII input is rejected with NULL — proper UTF-8 transcoding
- * can land in a follow-up if a real-world Cyrillic-password .pfx
- * surfaces. */
+/* UTF-8 → UTF-16LE without a terminator: the KDF input K_0 is the password
+ * as a Windows wide string. OPENSSL_utf82uni validates UTF-8 and yields
+ * UTF-16BE (with surrogate pairs for non-BMP code points) plus a 2-byte NUL
+ * terminator; swap the byte order and drop the terminator. Returns NULL on
+ * invalid UTF-8. Caller frees with OPENSSL_free. */
 static unsigned char *pwd_to_utf16le(const char *pass, int passlen,
                                      size_t *out_len)
 {
-    unsigned char *buf;
+    unsigned char *uni = NULL;
+    int unilen = 0;
     int i;
 
-    buf = OPENSSL_malloc((size_t)passlen * 2);
-    if (buf == NULL)
+    if (passlen == 0) {
+        /* OPENSSL_malloc(0) may return NULL; keep a valid empty buffer. */
+        uni = OPENSSL_malloc(1);
+        *out_len = 0;
+        return uni;
+    }
+    if (OPENSSL_utf82uni(pass, passlen, &uni, &unilen) == NULL)
         return NULL;
-    for (i = 0; i < passlen; i++) {
-        if ((unsigned char)pass[i] >= 0x80) {
-            OPENSSL_free(buf);
-            return NULL;
-        }
-        buf[2 * i]     = (unsigned char)pass[i];
-        buf[2 * i + 1] = 0;
+    if (unilen < 2) {
+        OPENSSL_clear_free(uni, (size_t)unilen);
+        return NULL;
+    }
+    unilen -= 2;
+    for (i = 0; i < unilen; i += 2) {
+        unsigned char t = uni[i];
+
+        uni[i] = uni[i + 1];
+        uni[i + 1] = t;
     }
-    *out_len = (size_t)passlen * 2;
-    return buf;
+    *out_len = (size_t)unilen;
+    return uni;
 }
 
 /* CryptoPro proprietary PBE KDF — iterated GOST R 34.11-94 over
